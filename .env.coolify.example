# Keep this false while Railway is still running the bot with the same token.
BOT_ENABLED=false

# Required only when BOT_ENABLED=true. Set either DISCORD_TOKEN or DISCORD_TOKENS.
DISCORD_TOKEN=
# DISCORD_TOKENS=

# Usable defaults for Coolify. Change secrets for production.
SERVICE_PASSWORD_POSTGRES=intro-postgres-password
POSTGRES_DB=intro_bot
POSTGRES_USER=intro

COOLDOWN_SECONDS=60
INTRO_HISTORY_MAX_SCAN=5000

# Optional intro API settings.
INTRO_API_KEY=
INTRO_API_HOST=0.0.0.0
INTRO_API_PORT=8000
INTRO_API_AUTH_FAILURE_LIMIT=10
INTRO_API_AUTH_FAILURE_WINDOW_SECONDS=60
INTRO_API_CORS_ORIGINS=

# Optional level-bot / stats-site integration.
LEVEL_API_BASE=
LEVEL_API_TIMEOUT_SECONDS=3
LEVEL_CACHE_TTL_SECONDS=60
USER_STATS_SITE_GUILD_ID=
USER_STATS_SITE_BASE_URL=
EXTERNAL_API_KEY=
LEVEL_CHILL_API_KEY=

POSTGRES_MEMORY_LIMIT=192m
POSTGRES_CPUS=0.50
BOT_MEMORY_LIMIT=256m
BOT_CPUS=0.75
API_MEMORY_LIMIT=192m
API_CPUS=0.50
