# 単一トークン
DISCORD_TOKEN=your-bot-token

# 複数トークンを並列起動する場合(カンマ区切り)。設定されていればこちらが優先される。
# DISCORD_TOKENS=token1,token2

# 新規ギルドのデフォルトクールダウン秒数(設定変更は /intro-config cooldown)
COOLDOWN_SECONDS=60

# 自己紹介チャンネルの履歴走査上限
INTRO_HISTORY_MAX_SCAN=5000

# DATABASE_URL is provided automatically:
#   - Local (docker compose): set in compose.yaml -> postgres service
#   - Railway: injected from the Postgres plugin via ${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://user:pass@host:5432/db
