# 単一トークン
DISCORD_TOKEN=your-bot-token

# 複数トークンを並列起動する場合(カンマ区切り)。設定されていればこちらが優先される。
# DISCORD_TOKENS=token1,token2

# 新規ギルドのデフォルトクールダウン秒数(設定変更は /intro-config cooldown)
COOLDOWN_SECONDS=60

# 自己紹介チャンネルの履歴走査上限
INTRO_HISTORY_MAX_SCAN=5000

# level-bot 連携: 取得したユーザーの総合レベルを VC 埋め込みの footer に表示する。
# 未設定/空ならレベル取得をスキップ(機能オフ)。
LEVEL_API_BASE=
LEVEL_API_TIMEOUT_SECONDS=3
# 同一ユーザーのレベル fetch をキャッシュする秒数(連続 VC 移動の高速化用)
LEVEL_CACHE_TTL_SECONDS=60

# /level と同じユーザー統計サイトへのリンクを自己紹介 embed に追加する。
# 両方設定され、投稿先ギルド ID と USER_STATS_SITE_GUILD_ID が一致すると有効。
# 例: USER_STATS_SITE_BASE_URL=https://example.com
USER_STATS_SITE_GUILD_ID=
USER_STATS_SITE_BASE_URL=

# level-bot 側で外部 API キー認証が有効な場合のみ設定する。
# 設定されていれば `Authorization: Bearer <key>` で送信する。
EXTERNAL_API_KEY=

# intro-bot 外部 API 用の Bearer キー。未設定なら EXTERNAL_API_KEY を流用する。
# 空のままだと外部 API は 401 を返す。
INTRO_API_KEY=
INTRO_API_HOST=0.0.0.0
INTRO_API_PORT=8000
INTRO_API_AUTH_FAILURE_LIMIT=10
INTRO_API_AUTH_FAILURE_WINDOW_SECONDS=60

# DATABASE_URL is provided automatically:
#   - Local (docker compose): set in compose.yaml -> postgres service
#   - Railway: injected from the Postgres plugin via ${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://user:pass@host:5432/db
